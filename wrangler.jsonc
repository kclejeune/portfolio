{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  // Workers Caching: cacheable responses (Cache-Control: public, max-age=...)
  // are served from the edge without invoking the Worker.
  "cache": {
    "enabled": true,
  },
  // The last successful GitHub profile (see src/lib/server/github.ts). No id:
  // `wrangler deploy` creates the namespace on first deploy and binds it.
  "kv_namespaces": [
    {
      "binding": "GITHUB_CACHE",
      "id": "0da1181b87d243a4b09443e3bcaa694c",
    },
  ],
  // Secret GITHUB_API_KEY is set with `wrangler secret put`. Not listed under
  // `secrets.required`, which warns on every build since builds never have it.
}
